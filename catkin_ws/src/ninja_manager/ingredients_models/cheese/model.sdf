<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="cheese">
    <static>false</static>

    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Inerzia e massa -->
<inertial>
  <mass>0.2</mass>
  <inertia>
    <ixx>0.00006015</ixx>
    <iyy>0.00006015</iyy>
    <izz>0.00012</izz>
    <ixy>0.0</ixy>
    <ixz>0.0</ixz>
    <iyz>0.0</iyz>
  </inertia>
</inertial>

      <!-- Collisione fisica -->
	<collision name="collision">
	  <geometry>
	  <box>
	    <size>0.06 0.06 0.003</size>
	  </box>
	  </geometry>
	  <surface>
	    <contact>
	      <collide_without_contact>false</collide_without_contact>
	      <ode>
		<max_vel>0</max_vel>
		<min_depth>0.001</min_depth>
	      </ode>
	    </contact>
	    <bounce>
	      <restitution_coefficient>0.0</restitution_coefficient>
	      <threshold>1.0</threshold>
	    </bounce>
	    <friction>
	      <ode>
		<mu>10.0</mu>
		<mu2>10.0</mu2>
	      </ode>
	    </friction>
	  </surface>
	</collision>


      <!-- Aspetto visuale -->
      <visual name="visual">
	<geometry>
	  <box>
	    <size>0.06 0.06 0.003</size>
	  </box>
	</geometry>
	  <material>
	    <ambient>1 0.9 0.3 1</ambient>       <!-- Giallo cheddar -->
	    <diffuse>1 0.8 0.2 1</diffuse>
	    <specular>0.3 0.3 0.1 1</specular>
	    <emissive>0 0 0 1</emissive>
	  </material>
      </visual>
    </link>
  </model>
</sdf>

