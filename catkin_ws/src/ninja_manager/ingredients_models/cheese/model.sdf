<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="cheese">
    <static>false</static>

    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Inerzia e massa -->
	<inertial>
	  <mass>0.02</mass>
	  <inertia>
	    <ixx>0.000004</ixx>
	    <iyy>0.000004</iyy>
	    <izz>0.000008</izz>
	    <ixy>0.0</ixy>
	    <ixz>0.0</ixz>
	    <iyz>0.0</iyz>
	  </inertia>
	</inertial>

      <!-- Collisione fisica -->
      <collision name="collision">
	<geometry>
	  <box>
	    <size>0.06 0.06 0.003</size>
	  </box>
	</geometry>
        <surface>
          <contact>
            <collide_without_contact>false</collide_without_contact>
          </contact>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1.0</threshold>
          </bounce>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Aspetto visuale -->
      <visual name="visual">
	<geometry>
	  <box>
	    <size>0.06 0.06 0.003</size>
	  </box>
	</geometry>
	  <material>
	    <ambient>1 0.9 0.3 1</ambient>       <!-- Giallo cheddar -->
	    <diffuse>1 0.8 0.2 1</diffuse>
	    <specular>0.3 0.3 0.1 1</specular>
	    <emissive>0 0 0 1</emissive>
	  </material>
      </visual>
    </link>
  </model>
</sdf>

