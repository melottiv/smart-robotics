<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="top_bread">
    <static>false</static>

    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Inerzia e massa -->
	<inertial>
	  <mass>0.04</mass>
	  <inertia>
	    <ixx>0.000012</ixx>
	    <iyy>0.000012</iyy>
	    <izz>0.000025</izz>
	    <ixy>0.0</ixy>
	    <ixz>0.0</ixz>
	    <iyz>0.0</iyz>
	  </inertia>
	</inertial>

      <!-- Collisione fisica -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://top_bread/meshes/top_bread.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <collide_without_contact>false</collide_without_contact>
          </contact>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1.0</threshold>
          </bounce>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Aspetto visuale -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://top_bread/meshes/top_bread.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
	<material>
	    <ambient>0.8 0.6 0.4 1</ambient> <!-- marroncino chiaro -->
	    <diffuse>0.8 0.6 0.4 1</diffuse>
	    <specular>0.1 0.1 0.1 1</specular>
	  </material>
      </visual>
    </link>
  </model>
</sdf>

