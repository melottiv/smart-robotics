<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="bread">
    <static>false</static>

    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>0.04</mass>
        <inertia>
          <ixx>0.000012</ixx>
          <iyy>0.000012</iyy>
          <izz>0.000025</izz>
          <ixy>0.0</ixy>
