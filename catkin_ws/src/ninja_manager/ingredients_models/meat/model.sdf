<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="meat">
    <static>false</static>

    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Inerzia e massa -->
<inertial>
  <mass>0.5</mass>
  <inertia>
    <ixx>0.00004</ixx>
    <iyy>0.00004</iyy>
    <izz>0.00008</izz>
    <ixy>0.0</ixy>
    <ixz>0.0</ixz>
    <iyz>0.0</iyz>
  </inertia>
</inertial>

      <!-- Collisione fisica -->
<collision name="collision">
	  <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.015</length>
          </cylinder>
	  </geometry>
	  <surface>
	    <contact>
	      <collide_without_contact>false</collide_without_contact>
	      <ode>
		<max_vel>0</max_vel>
		<min_depth>0.001</min_depth>
	      </ode>
	    </contact>
	    <bounce>
	      <restitution_coefficient>0.0</restitution_coefficient>
	      <threshold>1.0</threshold>
	    </bounce>
	    <friction>
	      <ode>
		<mu>2.0</mu>
		<mu2>2.0</mu2>
	      </ode>
	    </friction>
	  </surface>
	</collision>

      <!-- Aspetto visuale -->
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
	  <material>
	    <ambient>0.4 0.2 0.1 1</ambient>     <!-- Marrone scuro -->
	    <diffuse>0.5 0.25 0.15 1</diffuse>
	    <specular>0.1 0.1 0.1 1</specular>
	    <emissive>0 0 0 1</emissive>
	  </material>
      </visual>
    </link>
  </model>
</sdf>

