<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="meat">
    <static>false</static>

    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Inerzia e massa -->
<inertial>
  <mass>0.12</mass>
  <inertia>
    <ixx>0.00004</ixx>
    <iyy>0.00004</iyy>
    <izz>0.00008</izz>
    <ixy>0.0</ixy>
    <ixz>0.0</ixz>
    <iyz>0.0</iyz>
  </inertia>
</inertial>

      <!-- Collisione fisica -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://meat/meshes/meat.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <collide_without_contact>false</collide_without_contact>
          </contact>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1.0</threshold>
          </bounce>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Aspetto visuale -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://meat/meshes/meat.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
	  <material>
	    <ambient>0.4 0.2 0.1 1</ambient>     <!-- Marrone scuro -->
	    <diffuse>0.5 0.25 0.15 1</diffuse>
	    <specular>0.1 0.1 0.1 1</specular>
	    <emissive>0 0 0 1</emissive>
	  </material>
      </visual>
    </link>
  </model>
</sdf>

